# Template for the `githubissuemanager-secret` Secret. Copy it OUTSIDE the repository, fill it in,
# then create the Secret (never commit the filled-in file):
#
#   kubectl -n githubissuemanager create secret generic githubissuemanager-secret \
#     --from-env-file=/path/to/githubissuemanager-secret.env
#
# (`kubectl apply -R -f k8s/` only applies .yaml/.yml/.json files, so this file is never applied.)

# PostgreSQL
POSTGRES_DB=githubissuemanager
POSTGRES_USER=githubissuemanager
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# next-auth session encryption key: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me
# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_ID=your-oauth-client-id
GITHUB_SECRET=your-oauth-client-secret

# Optional: server-wide token enabling the Discover aggregator (no scopes needed). Leave empty to disable.
GITHUB_ACCESS_TOKEN=
# Optional: operator tokens for `POST /api/v1/command` (gi-cli control). At least 16 characters.
COMMANDER_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
