# Copy to `.env` (git-ignored) and fill in. Used by docker-compose.yml, and documents every
# variable read by the API server (app/server) and the website (Frontend/issuemanager).
# Never commit real values.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=githubissuemanager
POSTGRES_USER=githubissuemanager
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port for the local Postgres container (docker compose).
POSTGRES_HOST_PORT=5432

# ── API server (app/server) ───────────────────────────────────────────────────
# Either DATABASE_URL, or POSTGRES_HOST/POSTGRES_PORT + the POSTGRES_* values above.
# DATABASE_URL=postgres://githubissuemanager:change-me@localhost:5432/githubissuemanager
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# BIND_ADDRESS=0.0.0.0:8080
# DATABASE_MAX_CONNECTIONS=10
GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_SECS=15
# Seconds a validated user token is trusted before re-checking with GitHub.
# AUTH_CACHE_TTL_SECS=120
# Max pages (of 100 issues) fetched when syncing a tracked repository.
ISSUE_SYNC_MAX_PAGES=10
# Automatic refresh (dashboard): snapshots older than this are re-synced with conditional
# requests (unchanged repositories cost no GitHub rate limit). Minimum 60.
AUTO_SYNC_STALE_SECS=900
# Repositories refreshed per automatic run (1-50).
AUTO_SYNC_MAX_REPOS=10
# text (development) or json (production)
LOG_FORMAT=text
RUST_LOG=info,sqlx=warn

# Discover aggregator (optional). A server-owned GitHub token (no scopes needed); empty disables it.
GITHUB_ACCESS_TOKEN=
GRAPHQL_URL=https://api.github.com/graphql
DISCOVER_SYNC_INTERVAL_SECS=3600
# DISCOVER_SYNC_BATCH=100

# Operator tokens for POST /api/v1/command (gi-cli control). Optional; at least 16 characters.
COMMANDER_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=

# ── Website (Frontend/issuemanager) ──────────────────────────────────────────
# Public URL of the website; must match the GitHub OAuth App's callback URL host.
NEXTAUTH_URL=http://localhost:3000
# Session encryption key: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me
# GitHub OAuth App: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# GitHub Enterprise Server: GITHUB_WEB_URL=https://ghe.example.com, GITHUB_API_URL=https://ghe.example.com/api/v3
GITHUB_WEB_URL=https://github.com
# OAuth scopes. Use "read:user user:email public_repo" to restrict to public repositories.
# GITHUB_OAUTH_SCOPES=read:user user:email repo
# URL the website's server uses to reach the API (http://server:8080 inside docker compose).
BACKEND_URL=http://localhost:8080
